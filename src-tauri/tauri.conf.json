{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChromaDeck",
  "version": "0.9.6",
  "identifier": "com.chromadeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChromaDeck",
        "center": true,
        "width": 960,
        "height": 680,
        "minWidth": 800,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/miiidev/ChromaDeck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwOUYyMEIxOUE0RUI3QzAKUldUQXQwNmFzU0NmZ0c0eXJzcUdGV0xaSlZjNTN2TVZpbEp3RHMwdE1IaHhKNkVqWTc0Z0tpTHcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "miiidev",
    "resources": {
      "../NOTICE": "NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
